     "data": {
      "text/plain": [
       "{'path': 'E:/Masters thesis/Networks Dataset/Monoplex/Public/Social Networks/1k - 10K/',\n",
       " 'name': 'soc-hamsterster(2426 N and 16630 E)',\n",
       " 'type': '.edges'}"
