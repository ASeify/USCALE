    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "100%|██████████| 2426/2426 [01:10<00:00, 34.48it/s]\n"
     ]
    }
   ],
   "source": [
    "machine = WaveletMachine(graph, settings_args)\n",
    "print(\"Create Embedding\\n\")\n",
    "machine.create_embedding(target_nodes=selected_nodes)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 135,
   "metadata": {},
   "outputs": [],
   "source": [
    "nodes_embeddings = machine.get_real_and_imaginary_results()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 136,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "for i, node in enumerate(selected_nodes):\n",
    "    graph.nodes[node]['embedding'] = str(list(nodes_embeddings[i]))"
